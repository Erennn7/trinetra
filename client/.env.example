# Copy this file to .env and fill in your values
# Never commit .env to version control

# Gemini AI (Google Generative Language API)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Cloud (Speech-to-Text + Text-to-Speech)
VITE_GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# Firebase
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend service URLs
VITE_CROWD_API_URL=http://localhost:5000
VITE_DISASTER_API_URL=http://localhost:5001
VITE_WEAPON_API_URL=http://localhost:5002
VITE_LAF_API_URL=http://localhost:5003
