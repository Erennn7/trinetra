# Copy this file to .env and fill in your values
# Never commit .env to version control

# Firebase (React Native / Expo)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Maps (exposed to JS, must be prefixed with EXPO_PUBLIC_)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenRouteService (routing)
EXPO_PUBLIC_OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# Gemini / Google AI (server side only — never expose client-side)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
